# Copy to bridge/config/ros2_receiver.env and set mode 0600.
# BRIDGE_TOKEN must exactly match the Jetson sender configuration.
BRIDGE_HOST=192.168.144.60
BRIDGE_PORT=19001
BRIDGE_TOKEN=REPLACE_WITH_A_RANDOM_SHARED_TOKEN
ROS_DOMAIN_ID=71
DASHBOARD_PORT=18080
IMAGE_TOPIC=/camera/image
COMPRESSED_IMAGE_TOPIC=/camera/image/compressed
CAMERA_INFO_TOPIC=/camera/camera_info
POSE_TOPIC=/uav0/mavros/local_position/pose
BATTERY_TOPIC=/uav0/mavros/battery
STATE_TOPIC=/uav0/mavros/state
TRANSCODE_RAW_TO_JPEG=true
DECODE_COMPRESSED_TO_RAW=false
USE_IMAGE_TRANSPORT_DECODER=true
JPEG_QUALITY=80
