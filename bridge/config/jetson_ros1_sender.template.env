# Copy to ~/swarm-control-bridge/config/jetson_ros1_sender.env and set mode 0600.
# The sender only opens an observation server. It has no ROS publishers or
# MAVROS service clients.
BRIDGE_BIND_HOST=0.0.0.0
BRIDGE_PORT=19001
BRIDGE_TOKEN=REPLACE_WITH_A_RANDOM_SHARED_TOKEN
# Keep the default for packages installed in ROS Melodic. Set ROS1_OVERLAY_SETUP
# only when the active camera or MAVROS messages are installed in an existing
# read-only catkin overlay, for example /home/amov/<workspace>/devel/setup.bash.
ROS1_SETUP=/opt/ros/melodic/setup.bash
ROS1_OVERLAY_SETUP=
IMAGE_TOPIC=/camera/color/image_raw
COMPRESSED_IMAGE_TOPIC=/camera/color/image_raw/compressed
CAMERA_INFO_TOPIC=/camera/color/camera_info
POSE_TOPIC=/mavros/local_position/pose
BATTERY_TOPIC=/mavros/battery
STATE_TOPIC=/mavros/state
MAX_IMAGE_HZ=12
CAMERA_DEVICE_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=12
CAMERA_JPEG_QUALITY=80
CAMERA_FRAME_ID=camera_color_optical_frame
