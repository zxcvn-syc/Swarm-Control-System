<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planning_pkg</name>
  <version>0.1.0</version>
  <description>
    Path planning package: implements A* and D* Lite path planners, drives
    the swarm on a 2D occupancy grid, publishes DroneStateArray (so the
    Voronoi containment module can subscribe) and exposes planned paths
    for the RflySim / MAVROS bridge.
  </description>

  <maintainer email="swarm@example.com">Swarm Control System Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>swarm_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
