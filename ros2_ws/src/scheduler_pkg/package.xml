<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scheduler_pkg</name>
  <version>0.1.0</version>
  <description>
    Scheduler nodes: assigns perception targets to UAVs using greedy or
    Hungarian matching, publishes swarm_interfaces/TaskAssignment.
  </description>

  <maintainer email="swarm@example.com">Swarm Control System Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>swarm_interfaces</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
