# Real PX4 connection settings. Copy this file to
# /etc/swarm-control/real_uav_connection.env, set mode 0600, and fill every
# value marked REQUIRED. This file is sourced by scripts/real_uav_session.sh;
# it must remain root-owned and must not be committed after filling it.

# REQUIRED. Stable path shown by:
#   ls -l /dev/serial/by-id
# Do not use a changing /dev/ttyACM0 or /dev/ttyUSB0 path when a by-id path
# is available.
FCU_DEVICE=""

# REQUIRED. Must match the PX4 MAVLink instance attached to FCU_DEVICE.
# Common values are 57600, 115200, 460800, or 921600. Confirm in QGC/PX4;
# do not guess this value.
FCU_BAUD=""

# ROS graph identity for this physical aircraft. This must not be shared with
# SITL, replay, or development traffic.
ROS_DOMAIN_ID="71"
MAVROS_NAMESPACE="uav0/mavros"
FCU_SYSTEM_ID="1"
FCU_COMPONENT_ID="1"

# Empty keeps MAVROS from opening a separate GCS bridge.
GCS_URL=""

# Local browser port used by the operator dashboard. The dashboard binds only
# to 127.0.0.1; use an SSH tunnel for access from Windows.
DASHBOARD_PORT="18080"
